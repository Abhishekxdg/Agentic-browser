{
  "manifest_version": 3,
  "name": "Agent Browser",
  "version": "0.1.0",
  "description": "Connect AI agents to your real browser — full auth, no bot detection, live control.",

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "sidePanel",
    "scripting",
    "cookies",
    "webNavigation",
    "history",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Agent Browser"
  },

  "web_accessible_resources": [
    {
      "resources": ["content/interceptor.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
