{
  "name": "sound-browser",
  "version": "0.7.1",
  "description": "TypeScript SDK for Sound Browser — Semantic Orchestration Unified Network Discovery",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepack": "bun run build"
  },
