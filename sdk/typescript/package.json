  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhishekxdg/Sound-Browser.git",
    "directory": "sdk/typescript"
  }
